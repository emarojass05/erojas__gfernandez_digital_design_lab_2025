// random_gen.sv — Generador pseudoaleatorio (LFSR de 8 bits)
module random_gen(
    input  logic clk,
    input  logic rst,
    output logic [2:0] rand_idx // valor entre 0 y 7
);
    logic [7:0] lfsr;

    always_ff @(posedge clk or posedge rst) begin
        if (rst)
            lfsr <= 8'hA5; // semilla
        else
            // feedback: x^8 + x^6 + x^5 + x^4 + 1
            lfsr <= {lfsr[6:0], lfsr[7] ^ lfsr[5] ^ lfsr[4] ^ lfsr[3]};
    end

    assign rand_idx = lfsr[2:0]; // 3 bits → 0–7
endmodule
