// card_selector.sv — Convierte switches en índice de carta (0–15)

module card_selector(
    input  logic [8:0] SW,       // SW0 = fila, SW1..SW8 = columna
    output logic [3:0] card_idx, // índice de la carta (0..15)
    output logic       valid     // 1 si hay selección válida
);

    logic [3:0] col;  // columna seleccionada
    logic       row;  // fila seleccionada (0=abajo, 1=arriba)

    always_comb begin
        row   = SW[0];    // fila elegida
        col   = 4'd0;     
        valid = 1'b0;     
        card_idx = 4'd0;  

        // detectar cuál de los switches SW1..SW8 está activo
        unique case (SW[8:1])
            8'b0000_0001: col = 4'd0; // primera columna
            8'b0000_0010: col = 4'd1;
            8'b0000_0100: col = 4'd2;
            8'b0000_1000: col = 4'd3;
            8'b0001_0000: col = 4'd4;
            8'b0010_0000: col = 4'd5;
            8'b0100_0000: col = 4'd6;
            8'b1000_0000: col = 4'd7;
            default:      col = 4'd0;
        endcase

        // si hay una sola columna activa, marcar selección válida
        if (SW[8:1] != 8'b0000_0000 && $onehot(SW[8:1])) begin
            valid = 1'b1;
            // índice = fila*8 + columna
            card_idx = row ? col : (col + 4'd8);
        end
    end

endmodule
