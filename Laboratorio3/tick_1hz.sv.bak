module tick_1hz #(
    parameter int CLK_HZ = 25_000_000
)(
    input  logic clk,
    input  logic rst,
    output logic tick
);
    localparam int DIV = CLK_HZ;
    localparam int W   = $clog2(DIV);
    logic [W-1:0] cnt;

    always_ff @(posedge clk) begin
        if (rst) begin
            cnt  <= 0;
            tick <= 0;
        end else begin
            if (cnt == DIV-1) begin
                cnt  <= 0;
                tick <= 1;
            end else begin
                cnt  <= cnt + 1;
                tick <= 0;
            end
        end
    end
endmodule
